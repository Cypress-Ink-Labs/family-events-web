{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": ["tests/**/*.{mjs,ts}"]
    },
    "apps/web": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.{ts,js}"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,js}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/design-system": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "packages/config-typescript": {
      "entry": [],
      "project": []
    },
    "packages/config-quality": {
      "entry": [],
      "project": []
    }
  },
  "ignore": [
    "apps/web/src/env.d.ts",
    "apps/web/src/test.d.ts",
    "apps/web/src/shared/components/ui/**",
    "packages/design-system/src/generated/**"
  ],
  "ignoreDependencies": [
    "@cypress-ink-labs/config-quality",
    "@cypress-ink-labs/config-typescript",
    "@cypress-ink-labs/design-system",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error"
  }
}

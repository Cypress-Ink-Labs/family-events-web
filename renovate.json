{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["@cypress-ink-labs/**"],
      "groupName": "family-events packages",
      "rangeStrategy": "bump",
      "automerge": false,
      "labels": ["dependencies", "family-events"]
    }
  ]
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "build/**",
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@cypress-ink-labs/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "../../node_modules/.tmp/apps-web*.tsbuildinfo"],
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "RAILWAY_GIT_COMMIT_SHA",
        "VITE_GOOGLE_SITE_VERIFICATION"
      ]
    },
    "@cypress-ink-labs/design-system#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "src/generated/**",
        "dist/**",
        "../../apps/web/src/styles/tokens.generated.css"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
